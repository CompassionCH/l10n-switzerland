<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="subscribe_template" name="E-Bill Subscription">
        <t t-call="portal.frontend_layout">
            <div class="oe_structure" />
                <div class="container py-5">
                    <div class="col-12 col-lg-6 mx-auto">
                        <h1 class="mb-4">Subscribe to E-Bill</h1>

                        <div t-if="error" class="alert alert-danger" role="alert">
                            <t t-esc="error"/>
                        </div>

                        <form action="/ebill/validate" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="mb-3">
                                <label for="email_input" class="form-label">E-Mail-Adresse:</label>
                                <input type="email" name="email" id="email_input" class="form-control" required="1" t-att-value="submitted_email" placeholder="mail@example.com"/>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary">Request validation code</button>
                            </div>
                        </form>
                    </div>
                </div>
            <div class="oe_structure" />
        </t>
    </template>

    <template id="validate_template" name="E-Bill Validation">
        <t t-call="portal.frontend_layout">
            <div class="oe_structure" />
                <div class="container py-5">
                    <div class="col-12 col-lg-6 mx-auto">
                        <h1 class="mb-4">Enter your validation code</h1>
                        <p>We have sent a validation code to <t t-esc="email"/>.</p>
                        <div t-if="error" class="alert alert-danger" role="alert">
                            <t t-esc="error"/>
                        </div>

                        <form action="/ebill/confirm" method="post">
                            <input type="hidden" name="token" t-att-value="token"/>
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="email" t-att-value="email"/>

                            <div class="mb-3">
                                <label for="validation_code_input" class="form-label">Validation code:</label>
                                <input type="text" name="validation_code" id="validation_code_input" class="form-control" required="1" t-att-value="submitted_email" placeholder="123456"/>
                            </div>
                            <div class="d-flex justify-content-end">
                                 <button t-if="error" type="submit" class="btn btn-secondary mr-2" formaction="/ebill/validate" formnovalidate="formnovalidate">Resend validation code</button>
                                <button type="submit" class="btn btn-primary">Confirm</button>
                            </div>
                        </form>
                    </div>
                </div>
             <div class="oe_structure" />
        </t>
    </template>

    <template id="success_template" name="E-Bill Subscription Successful">
        <t t-call="portal.frontend_layout">
            <div class="oe_structure" />
                <div class="container py-5">
                    <h1 class="mb-4">Thank you!</h1>
                    <p class="alert alert-success">You have successfully subscribed to E-Bill.</p>
                </div>
            <div class="oe_structure" />
        </t>
    </template>

    <template id="retry_template" name="E-Bill Subscription Failed">
        <t t-call="portal.frontend_layout">
            <div class="oe_structure" />
                <div class="container py-5">
                    <h1 class="mb-4">Unfortunately, something went wrong.</h1>
                    <p class="alert alert-danger">A technical error occurred. Please try the process again.</p>
                    <div class="d-flex justify-content-end">
                        <a type="submit" class="btn btn-primary" href="/ebill/subscribe">Retry</a>
                    </div>
                </div>
            <div class="oe_structure" />
        </t>
    </template>

</odoo>
