<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="subscribe_template" name="E-Bill Subscription">
            <h1>Subscribe to E-Bill</h1>

            <t t-if="error">
                <t t-esc="error"/>
            </t>

            <form action="/ebill/validate" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <label>E-Mail-Adresse:</label>
                <input type="email" name="email" required="1" t-att-value="submitted_email"/>
                <button type="submit">Request validation code</button>
            </form>
    </template>

    <template id="validate_template" name="E-Bill Validation">
        <h1>Enter your validation code</h1>
        <p>We have sent a validation code to <t t-esc="email"/>.</p>
        <p t-if="error" role="alert">
            <t t-esc="error"/>
        </p>

        <form action="/ebill/confirm" method="post">
            <input type="hidden" name="token" t-att-value="token"/>
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="email" t-att-value="email"/>
            <label>Validation code:</label>
            <input type="text" name="validation_code" required="1"/>
            <button type="submit">Confirm</button>
        </form>

        <form t-if="error" action="/ebill/validate" method="post">
            <input type="hidden" name="token" t-att-value="token"/>
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="email" t-att-value="email"/>
            <button type="submit">Resend validation code</button>
        </form>
    </template>

    <template id="success_template" name="E-Bill Subscription Successful">
        <h1>Thank you!</h1>
        <p>You have successfully subscribed to E-Bill.</p>
    </template>

    <template id="retry_template" name="E-Bill Subscription Failed">
        <h1>Unfortunately, something went wrong.</h1>
        <p>A technical error occurred. Please try the process again.</p>
        <a href="/ebill/subscribe" type="submit">Retry</a>
    </template>

</odoo>
