<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="salary_declaration_xml_view">
        <SalaryDeclaration>
            <Company>
                <CompanyDescription>
                    <AddressPosition>RIGHT</AddressPosition>
                    <Name>
                        <HR-RC-Name t-esc="docs[0].employee_id.company_id.name" />
                    </Name>
                    <Address>
                        <Street t-esc="docs[0].employee_id.company_id.street" />
                        <ZIP-Code t-esc="docs[0].employee_id.company_id.zip" />
                        <City t-esc="docs[0].employee_id.company_id.city" />
                        <Country
                            t-esc="docs[0].employee_id.company_id.country_id.name"
                        />
                    </Address>
                    <BUR-REE>
                        <CompanyWorkingTime CompanyWorkingTimeID="#1">
                            <WeeklyHours>1.00</WeeklyHours>
                        </CompanyWorkingTime>
                    </BUR-REE>
                </CompanyDescription>
                <Staff>
                    <Person t-foreach="docs" t-as="doc">
                        <t t-set="particulars" t-value="doc._get_particulars()" />
                        <Particulars>
                            <Language t-esc="particulars['language']" />
                            <DateOfBirth t-esc="doc.employee_id.birthday" />
                            <Social-InsuranceIdentification>
                                <SV-AS-Number
                                    t-esc="doc.employee_id.identification_id"
                                />
                            </Social-InsuranceIdentification>
                            <Lastname t-esc="particulars['lastname']" />
                            <Firstname t-esc="particulars['firstname']" />
                            <Address>
                                <Street t-esc="particulars['street']" />
                                <Postbox />
                                <ZIP-Code t-esc="particulars['zip']" />
                                <City t-esc="particulars['city']" />
                                <Country t-esc="particulars['country']" />
                            </Address>
                        </Particulars>
                        <TaxSalaries>
                            <TaxSalary>
                                <LohnausweisTyp>LOHNAUSWEIS</LohnausweisTyp>
                                <Period>
                                    <from t-esc="doc.date_from" />
                                    <until t-esc="doc.date_to" />
                                </Period>
                                <Year t-esc="doc.year" />
                                <Income t-esc="doc.income" />
                                <FreeTransport
                                    t-if="doc.company_car>0"
                                >True</FreeTransport>
                                <FringeBenefits t-if="doc.company_car>0">
                                    <CompanyCar t-esc="doc.company_car" />
                                </FringeBenefits>
                                <GrossIncome t-esc="doc.gross_income" />
                                <AHV-ALV-NBUV-AVS-AC-AANP-Contribution
                                    t-esc="doc.social_ded"
                                />
                                <BVG-LPP-Contribution>
                                    <Regular t-esc="doc.bvg_lpp_ded" />
                                </BVG-LPP-Contribution>
                                <!-- Same structure as an export of eLohnausweis SSK -->
                                <Charges t-if="doc.lump_sum_other > 0">
                                    <LumpSum>
                                        <Car />
                                        <Representation />
                                        <Other>
                                            <Sum t-esc="doc.lump_sum_other" />
                                            <Text t-esc="doc.lump_sum_other_text" />
                                        </Other>
                                    </LumpSum>
                                    <Education />
                                    <Effective>
                                        <Other>
                                            <Sum />
                                            <Text />
                                        </Other>
                                    </Effective>
                                </Charges>
                                <StandardRemark t-if="doc.child_allowance_by_fund">
                                    <ChildAllowancePerAHV-AVS
                                    >True</ChildAllowancePerAHV-AVS>
                                </StandardRemark>
                            </TaxSalary>
                        </TaxSalaries>
                    </Person>
                </Staff>
                <SalaryCounters />
            </Company>
            <GeneralSalaryDeclarationDescription>
                <CreationDate t-esc="time.strftime('%Y-%m-%d')" />
                <AccountingPeriod t-esc="docs[0].year" />
                <ContactPerson>
                    <Name t-esc="docs[0].create_uid.name" />
                    <PhoneNumber t-esc="docs[0].employee_id.company_id.phone" />
                </ContactPerson>
            </GeneralSalaryDeclarationDescription>
        </SalaryDeclaration>
    </template>

    <record id="salary_declaration_report" model="ir.actions.report">
        <field name="name">Salary certificate xml report</field>
        <field name="report_type">qweb-xml</field>
        <field
            name="report_name"
        >l10n_ch_hr_payroll_ecertificate.salary_declaration_xml_view</field>
        <field
            name="report_file"
        >l10n_ch_hr_payroll_ecertificate.salary_declaration_xml_view</field>
        <field name="print_report_name">'Yearly certificate report'</field>
        <field name="model">hr.salary.declaration</field>
    </record>
</odoo>
