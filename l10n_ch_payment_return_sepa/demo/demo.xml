<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Message with CC -->
        <record id="mail_message_cc" model="mail.message">
            <field name="partner_id" ref="base.res_partner_12" />
            <field name="user_id" ref="base.user_demo" />
            <field name="reference_type">none</field>
            <field name="payment_term_id" ref="account.account_payment_term" />
            <field name="type">in_invoice</field>
            <field name="date_invoice" eval="time.strftime('%Y-%m')+'-08'"/>
            <field name="payment_mode_id" ref="l10n_ch_pain_credit_transfer.payment_mode_outbound_sepa_ct_ch" />
            <field name="partner_bank_id" ref="l10n_ch_pain_credit_transfer.company_bank_post_xml_ct" />
            <field name="partner_ids" eval="[(6, 0, [ref('base.partner_demo')])]" />
            <field name="subject">Message with CC</field>
        </record>

    </data>
</odoo>
